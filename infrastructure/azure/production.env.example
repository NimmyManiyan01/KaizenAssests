# ==============================================================================
# Kaizen WMS Production Environment Configuration Blueprint (.env.production.example)
# Enforces enterprise security gates: non-root, SSL verify-full, and Key Vault mapping.
# ==============================================================================

# --- Service Identity --------------------------------------------------------
SERVICE_NAME=business-service
ENVIRONMENT=production
API_PREFIX=/api
LOG_LEVEL=INFO
LOG_JSON=true

# --- Production Security & HTTPS Gates (VAL-NEW-004) -------------------------
FORCE_HTTPS=true
ENABLE_API_DOCS=false
STARTUP_SCHEMA_COMPATIBILITY=false

# CORS & Trusted Hosts (Explicit production hostnames only; no localhost or wildcards)
CORS_ALLOW_ORIGINS=["https://wms.kaizen.com","https://api.kaizen.com"]
TRUSTED_HOSTS=["wms.kaizen.com","api.kaizen.com","kaizen-backend"]

# --- Azure Key Vault & Managed Identity (CHG-AZ-001) --------------------------
# Secret references are fetched directly via DefaultAzureCredential
AZURE_KEY_VAULT_URL=https://kaizen-wms-prod-kv.vault.azure.net/

# --- Database & TLS 1.3 verify-full (CHG-AZ-003, VAL-NEW-004) ----------------
# Connection string with DigiCert CA verify-full
DATABASE_URL=postgresql+asyncpg://ams_admin@kaizen-wms-prod-psql.postgres.database.azure.com:5432/ams_business?ssl=verify-full&sslrootcert=/etc/ssl/certs/DigiCertGlobalRootCA.crt.pem
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Azure Blob Storage for Documents & Media (CHG-AZ-002) -------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=kaizenwmsstorage;AccountKey=@Microsoft.KeyVault(VaultName=kaizen-wms-prod-kv;SecretName=storage-key);EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=kaizen-wms-media

# --- Telemetry & Application Insights (CHG-AZ-004) ----------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/
APPLICATIONINSIGHTS_SAMPLING_RATIO=0.5
OTEL_ENABLED=true

# --- JWT Authentication (RS256) ----------------------------------------------
JWT_ISSUER=ams-auth-service
JWT_AUDIENCE=ams-business-service
JWT_ALGORITHM=RS256
JWT_JWKS_URL=https://auth.kaizen.com/.well-known/jwks.json
LOCAL_SESSION_LIFETIME_MINUTES=60
LOGIN_MAX_FAILURES=5

# --- Background Worker Schedulers --------------------------------------------
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=50
DLQ_MAX_RETRIES=5

